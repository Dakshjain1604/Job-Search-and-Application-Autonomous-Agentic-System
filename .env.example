# OpenRouter API Key for AI evaluation, scoring & cold outreach notes
# If omitted, system runs on heuristic scoring with zero external API calls.
OPENROUTER_API_KEY=""

# Secret key to authenticate automated cron scans (/api/cron/scan)
CRON_SECRET="your-secure-random-token-here"

# Jina Reader API Key (Optional: 1M free tokens/mo, keyless fallback works up to 20 RPM)
JINA_API_KEY=""

# Optional Vercel / Cloud URL for GitHub Actions 12-hour automated job scanning
VERCEL_PROJECT_URL=""

# Optional Custom Chromium executable path (for headless automation on non-default paths)
# CHROME_PATH="/usr/bin/google-chrome"
